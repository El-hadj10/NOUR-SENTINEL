{
    "protocol": "NOUR-SENTINEL-JSON",
    "version": "3.0",
    "protocol_version": "3.0",
    "core_version": "0.5.0",
    "lab_version": "0.6.0-beta.4",
    "encoding": "UTF-8",
    "transport": "stdin-stdout",
    "sender": "rust-network-engine",
    "receiver": "python-brain",
    "document": {
        "kind": "reference",
        "read_by_code": false,
        "note": "Document de référence du contrat 3.0. Aucun module Rust ou Python ne lit ce fichier à l'exécution : il décrit ce que le code échange déjà. En cas d'écart, le code fait foi.",
        "authoritative_sources": {
            "request": "rust-engine/src/main.rs — objet input_data sérialisé sur stdin du processus Python",
            "response": "python-brain/intelligence/engine.py — objet retourné par analyze(), écrit sur stdout",
            "report_extensions": "rust-engine/src/main.rs — record_history() ajoute events, history, behavioral_changes et scope_changed au rapport affiché",
            "versions": "rust-engine/src/version.rs et python-brain/version.py"
        },
        "sections": {
            "contract": "Champs réellement produits et consommés, avec leurs types. C'est la partie normative.",
            "examples": "Valeurs illustratives complètes, cohérentes avec contract mais non normatives : elles ne constituent pas un schéma exhaustif au sens d'un validateur."
        }
    },
    "capability_status_values": {
        "started": "Capacité lancée, sans preuve de résultat exploitable.",
        "completed": "Collecte terminée avec une donnée produite ou des événements réellement analysés.",
        "failed": "Erreur d'exécution de la capacité.",
        "disabled": "Configuration excluant explicitement la capacité.",
        "no_data": "Capacité autorisée mais aucune cible, aucun produit ou aucune entrée à analyser.",
        "blocked_missing_permission": "Erreur d'exécution due à un privilège insuffisant (Permission denied, EACCES, etc.)."
    },
    "contract": {
        "request": {
            "required_keys": [
                "source",
                "devices",
                "events",
                "analysis_config",
                "inventory",
                "authorized_targets",
                "intelligence_config",
                "tools_config"
            ],
            "fields": {
                "source": "string — constante \"rust-network-engine\"",
                "devices": "array<NetworkDevice>",
                "events": "array<Event>",
                "analysis_config": "object — section analysis de settings.json",
                "inventory": "HostContext",
                "authorized_targets": "array<string> — cibles autorisées, dédupliquées et triées",
                "intelligence_config": "object — section intelligence de settings.json, transmise telle quelle",
                "tools_config": "object — section tools de settings.json, transmise telle quelle"
            },
            "objects": {
                "NetworkDevice": {
                    "ip": "string",
                    "mac": "string",
                    "interface": "string"
                },
                "Event": {
                    "type": "string — \"port_observed\"",
                    "ip": "string",
                    "port": "number",
                    "state": "string — \"open\" ou \"closed\""
                },
                "HostContext": {
                    "hostname": "string|null",
                    "kernel": "string|null",
                    "distribution": "string|null",
                    "os_id": "string|null",
                    "os_version": "string|null",
                    "architecture": "string|null",
                    "interfaces": "array<Interface>",
                    "listeners": "array<Listener>"
                },
                "Interface": {
                    "name": "string",
                    "state": "string",
                    "mac": "string|null",
                    "addresses": "array<string>"
                },
                "Listener": {
                    "address": "string",
                    "port": "number",
                    "family": "string — ipv4 ou ipv6",
                    "protocol": "string — tcp ou udp",
                    "state": "string",
                    "pid": "number|null",
                    "uid": "number|null",
                    "user": "string|null",
                    "process": "string|null",
                    "exe": "string|null",
                    "unit": "string|null",
                    "container": "string|null",
                    "confidence": "string — confirmed, probable ou unknown"
                },
                "analysis_config": {
                    "sensitive_ports": "array<number>",
                    "known_services": "object<string, string> — numéro de port vers nom de service"
                },
                "intelligence_config": {
                    "local_inventory": "boolean — lu par Rust uniquement (activation de l'inventaire local)",
                    "active_probing": "boolean — lu par Python",
                    "banner_timeout_ms": "number — lu par Python",
                    "http_probe": "boolean — lu par Python",
                    "tls_probe": "boolean — lu par Python",
                    "ssh_policy_audit": "boolean — lu par Python",
                    "journal_audit": "boolean — lu par Python",
                    "journal_lines": "number — lu par Python",
                    "sshd_config_path": "string — lu par Python",
                    "login_defs_path": "string — lu par Python"
                },
                "tools_config": {
                    "enabled": "boolean",
                    "nmap": "boolean",
                    "testssl": "boolean",
                    "trivy": "boolean",
                    "trivy_targets": "array<string>"
                }
            },
            "notes": [
                "intelligence_config et tools_config sont recopiés depuis settings.json : une clé supplémentaire y est transmise sans erreur, seules les clés ci-dessus sont lues.",
                "Un Listener dont confidence vaut unknown reste un socket lié : il ne prouve pas la présence d'un service applicatif."
            ]
        },
        "response": {
            "required_keys": [
                "engine",
                "version",
                "core_version",
                "lab_version",
                "protocol_version",
                "source",
                "capabilities",
                "capability_status",
                "network",
                "inventory",
                "services",
                "devices",
                "findings_count",
                "findings",
                "risk_summary",
                "tools_used",
                "errors",
                "status"
            ],
            "fields": {
                "engine": "string — \"NOUR SENTINEL\"",
                "version": "string — version du moteur (core)",
                "core_version": "string",
                "lab_version": "string",
                "protocol_version": "string — \"3.0\"",
                "source": "string — source reçue en entrée",
                "capabilities": "array<string> — les six capacités déclarées",
                "capability_status": "object<capacité, CapabilityStatus> — une entrée par capacité, sans omission",
                "network": "NetworkSummary",
                "inventory": "InventoryReport",
                "services": "array<Service> — produits identifiés localement, dédupliqués",
                "devices": "array<NetworkDevice> — repris tel quel depuis la requête",
                "findings_count": "number — longueur de findings",
                "findings": "array<Finding> — dédupliqués, triés par priority_score décroissant",
                "risk_summary": "RiskSummary",
                "tools_used": "array<string> — outils réellement exécutés",
                "errors": "array<string> — erreurs explicites, jamais masquées",
                "status": "string — \"analysis_completed\""
            },
            "notes": [
                "metadata est optionnel : intelligence/models.py ne l'ajoute que si un collecteur fournit des détails. Son absence est normale et ne rend pas le constat incomplet.",
                "priority_score et priority sont calculés après déduplication ; un constat brut n'en dispose pas encore."
            ],
            "objects": {
                "CapabilityStatus": {
                    "status": "string — une des six valeurs de capability_status_values",
                    "reason": "string — justification lisible du statut"
                },
                "NetworkSummary": {
                    "neighbors_discovered": "number",
                    "ports_observed": "number",
                    "open_ports": "number"
                },
                "InventoryReport": {
                    "hostname": "string|null",
                    "kernel": "string|null",
                    "architecture": "string|null",
                    "distribution": "string|null",
                    "os_id": "string|null",
                    "os_version": "string|null",
                    "interfaces": "array<Interface>",
                    "listeners_count": "number — longueur de listeners dans la requête",
                    "listeners": "array<ListenerReport>"
                },
                "ListenerReport": {
                    "address": "string",
                    "port": "number",
                    "family": "string",
                    "protocol": "string — tcp ou udp",
                    "state": "string — listen pour tcp, bound pour udp",
                    "pid": "number|null",
                    "uid": "number|null",
                    "user": "string|null",
                    "process": "string|null",
                    "exe": "string|null",
                    "unit": "string|null",
                    "container": "string|null",
                    "confidence": "string",
                    "socket_bound": "boolean",
                    "process_identified": "boolean",
                    "application_identified": "boolean",
                    "application_service": "string|null",
                    "application_verified": "boolean — toujours false dans cette version"
                },
                "Service": {
                    "service": "string",
                    "product": "string",
                    "version": "string|null",
                    "confidence": "string",
                    "evidence": "string",
                    "source": "string — local, banner ou tool",
                    "asset": "string",
                    "ip": "string|null",
                    "port": "number|null",
                    "exposure": "string — local, lan, wan ou unknown"
                },
                "Finding": {
                    "finding_id": "string",
                    "asset_id": "string",
                    "ip": "string|null",
                    "port": "number|null",
                    "service": "string|null",
                    "component": "string",
                    "check": "string",
                    "observation": "string",
                    "evidence": "string",
                    "confidence": "string",
                    "confidence_reason": "string",
                    "severity": "string — info, low, medium, high ou critical",
                    "severity_capped": "boolean",
                    "exposure": "string",
                    "references": "array<string>",
                    "recommendation": "string",
                    "status": "string — open ou to_verify",
                    "first_seen": "string — date ISO 8601",
                    "last_seen": "string — date ISO 8601",
                    "cve": "string|null",
                    "kev": "boolean",
                    "epss": "number|null",
                    "metadata": "object (optionnel) — détails propres au constat (unité, conteneur, origine, etc.) ; absent si aucun collecteur n'en fournit",
                    "priority_score": "number",
                    "priority": "string — P1, P2, P3 ou P4"
                },
                "RiskSummary": {
                    "total": "number",
                    "by_severity": "object — info, low, medium, high, critical",
                    "by_priority": "object — P1, P2, P3, P4",
                    "by_status": "object<statut, number> — répartition par statut de constat",
                    "with_evidence": "number",
                    "without_evidence": "number"
                }
            },
            "report_extensions": {
                "note": "Ajoutés par Rust dans le rapport final affiché ; absents de la réponse brute de Python.",
                "fields": {
                    "events": "array<Event> — événements envoyés au moteur",
                    "history": "HistoryStatus",
                    "behavioral_changes": "array<BehavioralChange>",
                    "scope_changed": "boolean"
                },
                "objects": {
                    "HistoryStatus": {
                        "status": "string — recorded, not_recorded ou unavailable",
                        "scan_id": "number — présent si status vaut recorded",
                        "previous_scan_id": "number|null — présent si status vaut recorded",
                        "scope_changed": "boolean — présent si status vaut recorded",
                        "error": "string — présent si status ne vaut pas recorded"
                    },
                    "BehavioralChange": {
                        "port": "number",
                        "ip": "string",
                        "change_type": "string — new, removed ou state_changed",
                        "previous_state": "string|null",
                        "current_state": "string|null"
                    }
                }
            }
        }
    },
