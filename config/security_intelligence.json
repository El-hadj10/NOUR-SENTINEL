{
    "application": {
        "name": "NOUR SENTINEL LAB",
        "version": "0.6.0-beta.2",
        "environment": "lab"
    },
    "authorized_targets": [
        "127.0.0.1",
        "localhost"
    ],
    "timeout": 2.0,
    "max_response_bytes": 65536,
    "inventory": {
        "packages": true,
        "services": true,
        "sockets": true,
        "max_packages": 5000
    },
    "probes": {
        "ssh_banner": true,
        "http_head": true,
        "tls": true
    },
    "journal": {
        "enabled": false,
        "lines": 200
    },
    "docker": {
        "enabled": true
    },
    "online": {
        "enabled": false,
        "max_requests": 20,
        "cache_ttl_seconds": 86400,
        "timeout_seconds": 10.0,
        "nvd_api_key_env": "NVD_API_KEY"
    },
    "reports": {
        "directory": "data/reports",
        "history_database": "data/history/nour_sentinel_intel.db"
    }
}
