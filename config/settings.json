
{
    "application": {
        "name": "NOUR SENTINEL",
        "version": "0.3.0",
        "environment": "development"
    },
    "engines": {
        "rust": {
            "enabled": true
        },
        "python": {
            "enabled": true,
            "executable": "python3"
        }
    },
    "network": {
        "targets": [
            "127.0.0.1"
        ],
        "discover_arp": true,
        "scan_discovered_devices": false,
        "ports": [
            22,
            80,
            443,
            3389,
            5900
        ],
        "timeout_ms": 500,
        "max_concurrency": 10
    },
    "analysis": {
        "sensitive_ports": [
            23,
            3389,
            5900
        ],
        "known_services": {
            "22": "SSH",
            "53": "DNS",
            "80": "HTTP",
            "443": "HTTPS",
            "3306": "MySQL",
            "5432": "PostgreSQL",
            "8080": "HTTP Alternative"
        }
    },
    "security": {
        "authorized_scanning_only": true,
        "automatic_actions": false
    }
}
